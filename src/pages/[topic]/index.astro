---
// Hub page for a topic, e.g. /dismissed-as-normal/
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Text from '../../components/Text.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const topics = await getCollection('topics', (t) => t.data.status === 'live');
  return topics.map((topic) => ({ params: { topic: topic.id }, props: { topic } }));
}

const { topic } = Astro.props as { topic: CollectionEntry<'topics'> };
const { Content } = await render(topic);
const problems = (await getCollection('problems', (p) => p.id.startsWith(`${topic.id}/`))).sort(
  (a, b) => a.data.order - b.data.order,
);
import PageBand from '../../components/PageBand.astro';
import CycleSpot from '../../components/spots/CycleSpot.astro';
---
<Base title={topic.data.title} description={topic.data.hook}>
  <PageBand title={topic.data.title} hook={topic.data.hook} eyebrow="Act 1 · Where care falls short" eyebrowHref={url('/#act-1')}>
    <CycleSpot />
  </PageBand>
  <article class="page">
    <Content />

    <ul class="row-list">
      {
        problems.map((p) => (
          <li>
            <a href={url(`/${p.id}/`)}>
              <h3>{p.data.title}</h3>
              <p><Text text={p.data.hook} /></p>
            </a>
          </li>
        ))
      }
      {
        topic.data.comingSoon.map((name) => (
          <li class="coming-soon">
            <div class="row">
              <span class="tag">Coming soon</span>
              <h3>{name}</h3>
            </div>
          </li>
        ))
      }
    </ul>
  </article>
</Base>
