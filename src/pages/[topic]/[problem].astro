---
// A problem page, e.g. /the-cycle/endometriosis/
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Text from '../../components/Text.astro';
import StatCallout from '../../components/StatCallout.astro';
import SourcesList from '../../components/SourcesList.astro';
import Lifeline from '../../components/Lifeline.astro';
import { splitProblemBody } from '../../lib/content';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const problems = await getCollection('problems');
  return Promise.all(
    problems.map(async (problem) => {
      const [topicId, problemId] = problem.id.split('/');
      const topic = problemId ? await getEntry('topics', topicId) : undefined;
      if (!topic) {
        throw new Error(
          `${problem.filePath} must sit inside a topic folder that matches a file in src/content/topics/ ` +
            `(e.g. src/content/problems/the-cycle/endometriosis.md).`,
        );
      }
      return { params: { topic: topicId, problem: problemId }, props: { problem, topic } };
    }),
  );
}

const { problem, topic } = Astro.props as {
  problem: CollectionEntry<'problems'>;
  topic: CollectionEntry<'topics'>;
};
const { title, hook, stats, sources, mentalHealth, lastReviewed } = problem.data;
const body = splitProblemBody(problem);
---
<Base title={title} description={hook}>
  <p class="breadcrumb"><a href={url(`/${topic.id}/`)}>{topic.data.title}</a></p>
  <h1>{title}</h1>
  <p class="hook"><Text text={hook} /></p>

  {mentalHealth && <Lifeline />}

  <Fragment set:html={body.summary} />

  <section class="stats" aria-label="Key statistics">
    {stats.map((s) => <StatCallout {...s} />)}
  </section>

  <Fragment set:html={body.whyAustralia} />
  {body.globalContext && <Fragment set:html={body.globalContext} />}

  <SourcesList sources={sources} />

  <p class="last-reviewed">
    Last reviewed:{' '}
    {
      lastReviewed === 'not yet reviewed' ? (
        <mark class="placeholder">[NOT YET REVIEWED]</mark>
      ) : (
        <time datetime={lastReviewed.toISOString().slice(0, 10)}>
          {lastReviewed.toLocaleDateString('en-AU', { day: 'numeric', month: 'long', year: 'numeric' })}
        </time>
      )
    }
  </p>
</Base>
