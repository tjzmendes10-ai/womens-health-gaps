---
// A condition page inside a hub, e.g. /dismissed-as-normal/endometriosis/
// Single-page topics (e.g. heart-disease/overview.md) are served at the
// topic's own address by [topic]/index.astro instead.
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import ProblemPage from '../../components/ProblemPage.astro';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const problems = (await getCollection('problems')).filter((p) => !p.id.endsWith('/overview'));
  return Promise.all(
    problems.map(async (problem) => {
      const [topicId, problemId] = problem.id.split('/');
      const topic = problemId ? await getEntry('topics', topicId) : undefined;
      if (!topic) {
        throw new Error(
          `${problem.filePath} must sit inside a topic folder that matches a file in src/content/topics/ ` +
            `(e.g. src/content/problems/dismissed-as-normal/endometriosis.md).`,
        );
      }
      return { params: { topic: topicId, problem: problemId }, props: { problem, topic } };
    }),
  );
}

const { problem, topic } = Astro.props as {
  problem: CollectionEntry<'problems'>;
  topic: CollectionEntry<'topics'>;
};
---
<ProblemPage problem={problem} crumbLabel={topic.data.title} crumbHref={url(`/${topic.id}/`)} />
