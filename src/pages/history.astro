---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Origins from '../components/Origins.astro';
import { getPage } from '../lib/content';
import { url } from '../lib/url';

const page = await getPage('history', 'history');
const { Content } = await render(page);
import PageBand from '../components/PageBand.astro';
import PagesSpot from '../components/spots/PagesSpot.astro';
---
<Base title={page.data.title} description={page.data.description}>
  <PageBand title={page.data.title} eyebrow="Act 2">
    <PagesSpot />
  </PageBand>
  <article class="page">
    <Content />
    <p class="history-numbers">The key figures from this history are also set out in <a href={url('/in-numbers/#then')}>In numbers: Then</a>.</p>
    <Timeline />
    <Origins />
  </article>
</Base>
