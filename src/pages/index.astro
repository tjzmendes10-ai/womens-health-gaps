---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Text from '../components/Text.astro';
import HeroScene from '../components/HeroScene.astro';
import HomeTeaser from '../components/numbers/HomeTeaser.astro';
import CycleScene from '../components/scenes/CycleScene.astro';
import HistoryScene from '../components/scenes/HistoryScene.astro';
import FutureScene from '../components/scenes/FutureScene.astro';
import { getPage } from '../lib/content';
import { url } from '../lib/url';

const home = await getPage('home', 'home');
const { Content } = await render(home);
const topics = (await getCollection('topics')).sort((a, b) => a.data.order - b.data.order);
const { act1, act2, act3 } = home.data;

// Highlight the second half of the headline ("living sicker") in saffron.
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const [first, ...rest] = home.data.title.split(', ');
const heroTitle = rest.length ? `${escape(first)}, <span class="hl">${escape(rest.join(', '))}</span>` : escape(home.data.title);
---
<Base title={home.data.title} description={home.data.description}>
  <section class="hero" aria-labelledby="hero-title">
    <HeroScene titleHtml={heroTitle} eyebrow="Women's health, in three acts" />
    <div class="hero-text">
      <div class="home-intro"><Content /></div>
    </div>
  </section>

  <HomeTeaser />

  <section class="act" id="act-1" aria-labelledby="act-1-title">
    <div class="act-inner">
      <p class="eyebrow">Act 1</p>
      <div>
        <h2 id="act-1-title">{act1.title}</h2>
        <p class="act-blurb"><Text text={act1.blurb} /></p>
        <ul class="row-list">
          {
            topics.map((t) => {
              // Sources for figures in the card text: short "Publisher, year" links.
              const cardSources = t.data.sources.length > 0 && (
                <p class="card-sources">
                  {t.data.sources.length === 1 ? 'Source' : 'Sources'}:{' '}
                  {t.data.sources.map((s, i) => (
                    <>
                      {i > 0 && '; '}
                      {s.needed ? <mark class="placeholder">[SOURCE NEEDED – {s.needed}]</mark> : <a href={s.url}>{s.publisher}{s.year ? `, ${s.year}` : ''}</a>}
                    </>
                  ))}
                </p>
              );
              return t.data.status === 'coming-soon' ? (
                <li class="coming-soon">
                  <div class="row">
                    <span class="tag">Coming soon</span>
                    <h3>{t.data.title}</h3>
                    <div>
                      <p><Text text={t.data.hook} /></p>
                      {cardSources}
                    </div>
                  </div>
                </li>
              ) : (
                <li>
                  <a href={url(`/${t.id}/`)}>
                    <h3>{t.data.title}</h3>
                    <p><Text text={t.data.hook} /></p>
                  </a>
                  {cardSources}
                </li>
              );
            })
          }
        </ul>
        <CycleScene />
      </div>
    </div>
  </section>

  <section class="act" id="act-2" aria-labelledby="act-2-title">
    <div class="act-inner">
      <p class="eyebrow">Act 2</p>
      <div>
        <h2 id="act-2-title"><a href={url('/history/')}>{act2.title}</a></h2>
        <p class="act-blurb"><Text text={act2.blurb} /></p>
        <a class="read-more" href={url('/history/')}>See the timeline</a>
        <HistoryScene />
      </div>
    </div>
  </section>

  <section class="act" id="act-3" aria-labelledby="act-3-title">
    <div class="act-inner">
      <p class="eyebrow">Act 3</p>
      <div>
        <h2 id="act-3-title"><a href={url('/where-were-headed/')}>{act3.title}</a></h2>
        <p class="act-blurb"><Text text={act3.blurb} /></p>
        <a class="read-more" href={url('/where-were-headed/')}>Read on</a>
        <FutureScene />
      </div>
    </div>
  </section>
</Base>
