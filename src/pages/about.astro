---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import MedicalDisclaimer from '../components/MedicalDisclaimer.astro';
import { getPage } from '../lib/content';

const page = await getPage('about', 'about');
const { Content } = await render(page);
import PageBand from '../components/PageBand.astro';
import CardsSpot from '../components/spots/CardsSpot.astro';
---
<Base title={page.data.title} description={page.data.description}>
  <PageBand title={page.data.title}>
    <CardsSpot />
  </PageBand>
  <article class="page">
    <Content />
    <h2>Not medical advice</h2>
    <MedicalDisclaimer />
  </article>
</Base>
