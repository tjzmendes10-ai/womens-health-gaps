---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Text from '../components/Text.astro';
import PageBand from '../components/PageBand.astro';
import SunSpot from '../components/spots/SunSpot.astro';
import Source from '../components/Source.astro';
import { getPage } from '../lib/content';
import { PLACEHOLDER_TITLE } from '../lib/placeholder-plugins.mjs';

const page = await getPage('headed', 'headed');
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <PageBand title={page.data.title} eyebrow="Act 3">
    <SunSpot />
  </PageBand>
  <article class="page">
    <Content />
  </article>

  <!-- A saffron sun rises as this comes into view (static if motion is off) -->
  <div class="sunrise" aria-hidden="true">
    <svg viewBox="0 0 600 150" preserveAspectRatio="xMidYMax meet" focusable="false" overflow="visible">
      <g class="sun-disc">
        <g stroke-width="6" stroke-linecap="round" style="stroke:var(--accent)">
          <path d="M300,8 V-8 M232,30 L220,18 M368,30 L380,18 M200,78 H182 M400,78 H418"></path>
        </g>
        <circle cx="300" cy="118" r="70" style="fill:var(--accent)"></circle>
      </g>
      <path d="M-900,112 C-500,96 -200,124 -20,118 C80,92 180,104 290,118 C400,132 500,100 620,108 C800,116 1100,96 1500,110 L1500,160 L-900,160 Z" style="fill:var(--brand-mid)"></path>
      <path d="M-900,136 C-500,128 -200,144 -20,140 C120,124 260,148 400,136 C480,130 560,136 620,132 C900,126 1200,140 1500,132 L1500,160 L-900,160 Z" style="fill:var(--accent)"></path>
    </svg>
  </div>

  <section class="actions-panel" aria-labelledby="changes-heading">
    <div class="page">
      <h2 id="changes-heading">{page.data.changesTitle}</h2>
      <p class="panel-lead">The system has to change. Individual women shouldn't have to carry it.</p>
      <ul class="change-cards">
        {
          page.data.changes.map((c) => (
            <li class="change-card">
              <h3><Text text={c.who} /></h3>
              <ul>
                {c.points.map((pt) => <li><Text text={pt} /></li>)}
              </ul>
              {c.sources.length > 0 && (
                <div class="change-sources">
                  <p>{c.sources.length === 1 ? 'Source' : 'Sources'}</p>
                  <ul>
                    {c.sources.map((src) => <li><Source source={src} /></li>)}
                  </ul>
                </div>
              )}
            </li>
          ))
        }
      </ul>

      <h2 id="you-heading" class="you-heading">{page.data.youTitle}</h2>
      <ol class="you-list" aria-labelledby="you-heading">
        {
          page.data.actions.map((a) => (
            <li>
              <h3><Text text={a.title} /></h3>
              <p><Text text={a.description} /></p>
              {a.needed ? (
                <p><mark class="placeholder" title={PLACEHOLDER_TITLE}>[LINK NEEDED – {a.needed}]</mark></p>
              ) : (
                a.url && <a class="action-link" href={a.url}>{a.organisation}</a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>
