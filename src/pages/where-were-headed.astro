---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Text from '../components/Text.astro';
import { getPage } from '../lib/content';
import { PLACEHOLDER_TITLE } from '../lib/placeholder-plugins.mjs';

const page = await getPage('headed', 'headed');
const { Content } = await render(page);
---
<Base title={page.data.title} description={page.data.description}>
  <article class="page">
    <p class="eyebrow">Act 3</p>
    <h1>{page.data.title}</h1>
    <Content />

    <section aria-labelledby="actions-heading">
      <h2 id="actions-heading">{page.data.actionsTitle}</h2>
      <ol class="action-list">
        {
          page.data.actions.map((a) => (
            <li>
              <div>
                <h3><Text text={a.title} /></h3>
                <p><Text text={a.description} /></p>
                <p>
                  {a.needed ? (
                    <mark class="placeholder" title={PLACEHOLDER_TITLE}>[LINK NEEDED – {a.needed}]</mark>
                  ) : (
                    <a class="action-link" href={a.url}>{a.organisation}</a>
                  )}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>
  </article>
</Base>
