---
// A single statistic: big number, short context line, region tag, source link.
// The "chart" slot is empty for now; a small chart can be dropped in later
// without changing how stats are written in markdown.
import Text from './Text.astro';

interface Props {
  value: string;
  label: string;
  region: 'Australia' | 'Global';
  source: number;
}
const { value, label, region, source } = Astro.props;
---
<figure class="stat" data-region={region.toLowerCase()}>
  <p class="stat-value"><Text text={value} /></p>
  <figcaption><Text text={label} /></figcaption>
  <slot name="chart" />
  <div class="stat-meta">
    <span class="tag">{region}</span>
    <a class="stat-source" href={`#source-${source}`}>Source {source}</a>
  </div>
</figure>
