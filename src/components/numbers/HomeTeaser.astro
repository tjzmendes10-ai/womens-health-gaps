---
// Home page teaser for the In numbers page: women's share of heart disease
// trial participants vs their share of the disease burden (same data as the
// trials scene on /in-numbers/).
import { heartTrials, trialCount, TRIALS_FILES } from '../../lib/data/ctgov-trials';
import { GBD_YEAR } from '../../lib/data/gbd-yld';
import { csvUrl } from '../../lib/data/csv';
import { url } from '../../lib/url';

const heart = heartTrials();
const n = trialCount();
const r0 = (n: number) => Math.round(n);
---
<section class="numbers-teaser" aria-labelledby="teaser-headline">
  <div class="ledger">
    <p class="scene-eyebrow"><span class="tag">Global</span><span class="scene-year">Trials {n.firstYear}–{n.lastYear}</span></p>
    <p class="teaser-figures" aria-hidden="true">
      <span class="teaser-pair"><span class="teaser-women">{r0(heart.pooled)}%</span> <span class="teaser-vs">of trial participants</span></span>
      <span class="teaser-pair"><span class="teaser-second">{r0(heart.burden)}%</span> <span class="teaser-vs">of the burden</span></span>
    </p>
    <h2 class="scene-headline" id="teaser-headline">Women are {r0(heart.pooled)}% of heart disease trial participants but carry {r0(heart.burden)}% of the burden.</h2>
    <p class="scene-source">
      Ratio of two sources: our analysis of <a href="https://clinicaltrials.gov/">ClinicalTrials.gov</a> and <a href="https://vizhub.healthdata.org/gbd-results/">IHME, GBD {GBD_YEAR}</a>.
      Data: {TRIALS_FILES.map((f, i) => <>{i > 0 && ', '}<a href={csvUrl(f.file)}><code>{f.file}</code></a></>)}
    </p>
    <p class="teaser-link"><a href={url('/in-numbers/')}>See the rest in numbers</a></p>
  </div>
</section>
