---
// A door: closed (1977) or open with light spilling out (1993).
interface Props { open?: boolean }
const { open = false } = Astro.props;
---
<svg viewBox="0 0 160 160" aria-hidden="true" focusable="false">
  <rect x="40" y="18" width="80" height="128" rx="6" style="fill:var(--brand-deep)"></rect>
  {
    open ? (
      <>
        <rect x="48" y="26" width="64" height="120" style="fill:var(--accent-soft)"></rect>
        <path d="M48,146 L112,146 L150,158 L10,158 Z" opacity="0.45" style="fill:var(--accent-soft)"></path>
        <path d="M48,26 L24,34 L24,140 L48,146 Z" style="fill:var(--accent)"></path>
        <circle cx="30" cy="88" r="3" style="fill:var(--cream)"></circle>
      </>
    ) : (
      <>
        <rect x="48" y="26" width="64" height="120" style="fill:var(--accent)"></rect>
        <rect x="58" y="40" width="44" height="14" rx="3" style="fill:var(--outline)"></rect>
        <circle cx="102" cy="90" r="4" style="fill:var(--accent-soft)"></circle>
      </>
    )
  }
  <rect x="20" y="146" width="120" height="5" rx="2.5" opacity="0.6" style="fill:var(--brand-mid)"></rect>
</svg>
