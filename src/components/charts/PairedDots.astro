---
// Two dots per row (women and men), joined by a line.
interface Row { label: string; women: number; men: number }
interface Props { id: string; title: string; desc: string; rows: Row[]; min: number; max: number; unit: string; axisLabel: string }
const { id, title, desc, rows, min, max, unit, axisLabel } = Astro.props;
const W = 400, PAD_L = 4, PAD_R = 4, ROW_H = 50, TOP = 30;
const plotW = W - PAD_L - PAD_R;
const x = (v: number) => PAD_L + ((v - min) / (max - min)) * plotW;
const H = TOP + rows.length * ROW_H + 30;
const ticks: number[] = [];
for (let t = Math.ceil(min); t <= max; t += 2) ticks.push(t);
const f = (n: number) => n.toFixed(1);
---
<svg class="chart" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-t ${id}-d`}>
  <title id={`${id}-t`}>{title}</title>
  <desc id={`${id}-d`}>{desc}</desc>
  <g class="legend">
    <circle class="dot-women" cx="7" cy="10" r="6" /><text class="ct" x="18" y="14.5">Women</text>
    <circle class="dot-men" cx="82" cy="10" r="6" /><text class="ct" x="93" y="14.5">Men</text>
  </g>
  {ticks.map((t) => <line class="grid" x1={x(t)} x2={x(t)} y1={TOP} y2={H - 26} />)}
  {
    rows.map((r, i) => {
      const y = TOP + i * ROW_H + 34;
      return (
        <g>
          <text class="ct ct-strong" x={PAD_L} y={y - 14}>{r.label}</text>
          <line class="joiner" x1={x(r.men)} x2={x(r.women)} y1={y} y2={y} />
          <circle class="dot-men" cx={x(r.men)} cy={y} r="6" />
          <circle class="dot-women" cx={x(r.women)} cy={y} r="6" />
          <text class="ct ct-muted" x={x(Math.min(r.men, r.women)) - 10} y={y + 4.5} text-anchor="end">{f(Math.min(r.men, r.women))}</text>
          <text class="ct ct-strong" x={x(Math.max(r.men, r.women)) + 10} y={y + 4.5}>{f(Math.max(r.men, r.women))}</text>
        </g>
      );
    })
  }
  {ticks.map((t) => <text class="ct ct-small ct-muted" x={x(t)} y={H - 10} text-anchor="middle">{t}</text>)}
  <text class="ct ct-small ct-muted" x={W - PAD_R} y={H - 10 - 14} text-anchor="end">{axisLabel} ({unit})</text>
</svg>
